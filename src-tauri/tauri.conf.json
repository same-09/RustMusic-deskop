{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustMusic",
  "version": "0.1.0",
  "identifier": "com.rustmusic.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "RustMusic", "width": 1100, "height": 720, "center": true, "minWidth": 720, "minHeight": 480, "decorations": false }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
